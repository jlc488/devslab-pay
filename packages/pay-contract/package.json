{
  "name": "@devslab-kr/pay-contract",
  "version": "0.2.0",
  "description": "Versioned wire contract for DevsLab Pay: RPC types, constants, the import digest and response parsers.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlc488/devslab-pay.git",
    "directory": "packages/pay-contract"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": false,
  "files": ["dist", "CHANGELOG.md"],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:consumer",
    "test:consumer": "npm run build && tsc --project tests/consumer/tsconfig.json"
  }
}
