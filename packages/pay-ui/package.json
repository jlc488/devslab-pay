{
  "name": "@devslab-kr/pay-ui",
  "version": "0.2.0",
  "description": "Presentational React components for DevsLab Pay data: recharge amount, order history, order summary and test wallet.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlc488/devslab-pay.git",
    "directory": "packages/pay-ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": ["./dist/styles.css"],
  "files": ["dist", "CHANGELOG.md"],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/styles.css','dist/styles.css')\"",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@devslab-kr/pay-contract": "0.3.0"
  },
  "peerDependencies": {
    "@devslab/dds-react": "^0.21.2",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@devslab/dds-react": "0.21.2",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "27.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
