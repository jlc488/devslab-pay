{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devslab-pay-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devslab-pay-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PAY_EXTERNAL_ACTIONS_ENABLED": "false",
    "PAY_CONNECTION_VERIFICATION_ENABLED": "true"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "enabled": true,
    "traces": {
      "enabled": false
    }
  }
}
