{
  "name": "devslab-pay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev --local",
    "db:migrate:local": "wrangler d1 migrations apply devslab-pay-local --local",
    "test:worker": "node scripts/test-worker.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261011.1",
    "@types/node": "24.19.2",
    "miniflare": "5.20261006.1-alpha",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
